{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "portfolio": {
      "root": "portfolio",
      "framework": "django"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "portfolio"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
    ]
}