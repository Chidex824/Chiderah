{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "portfolio": {
      "root": "portfolio",
      "framework": "django"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "bindings": [
    { "type": "service", "service": "inventory", "format": "url", "env": "INVENTORY_URL" }
  ]
}